Vagrant.configure("2") do |config|
    if RUBY_PLATFORM.include?("arm64")
      config.vm.box = "bento/ubuntu-22.04-arm64"
    else
      config.vm.box = "bento/ubuntu-22.04"
    end
    # KVM via libvirt is the native virtualization on Fedora and most Linux
    # hosts, and avoids VirtualBox's out-of-tree kernel modules, which break on
    # kernel updates and with Secure Boot enabled.
    #
    # The bento boxes above publish virtualbox, vmware, parallels and utm only -
    # there is no libvirt variant - so the box is swapped for a libvirt-capable
    # one here rather than failing at `vagrant up --provider=libvirt`.
    # cloud-image/ubuntu-22.04 is a more recently rebuilt alternative.
    #
    # 9p keeps the /vagrant synced folder working without an NFS server on the
    # host. If it gives trouble, remove the type and accessmode options and
    # vagrant-libvirt falls back to NFS (needs nfs-utils and firewall rules).
    config.vm.provider "libvirt" do |lv, override|
      override.vm.box = "generic/ubuntu2204"
      override.vm.synced_folder ".", "/vagrant", type: "9p", accessmode: "mapped"
    end

    config.vm.provision "shell", inline: <<-SHELL
        apt-get update -y
        echo "10.0.0.10  control-plane" >> /etc/hosts
        echo "10.0.0.11  node01" >> /etc/hosts
        echo "10.0.0.12  node02" >> /etc/hosts
    SHELL
    config.vm.synced_folder ".", "/vagrant" 
    config.vm.define "control-plane", primary: true  do |master|
      master.vm.hostname = "control-plane"
      master.vm.network "private_network", ip: "10.0.0.10", virtualbox__intnet: true
      master.vm.provider "virtualbox" do |vb|
          vb.memory = 2048
          vb.cpus = 2
      end
      master.vm.provider "libvirt" do |lv|
          lv.memory = 2048
          lv.cpus = 2
      end
      master.vm.provider "vmware_fusion" do |vm|
          vm.vmx["memsize"] = "2048"
          vm.vmx["numvcpus"] = "2"
      end
      master.vm.provision "shell", path: "scripts/common.sh"
      master.vm.provision "shell", path: "scripts/cp.sh"
    end

    (1..2).each do |i|
  
    config.vm.define "node0#{i}" do |node|
      node.vm.hostname = "node0#{i}"
      node.vm.network "private_network", ip: "10.0.0.1#{i}", virtualbox__intnet: true
      node.vm.provider "virtualbox" do |vb|
          vb.memory = 2048
          vb.cpus = 1
      end
      node.vm.provider "libvirt" do |lv|
          lv.memory = 2048
          lv.cpus = 1
      end
      node.vm.provider "vmware_fusion" do |vm|
          vm.vmx["memsize"] = "2048"
          vm.vmx["numvcpus"] = "1"
      end
      node.vm.provision "shell", path: "scripts/common.sh"
      node.vm.provision "shell", path: "scripts/node.sh"
    end
    
    end
  end
